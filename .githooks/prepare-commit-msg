#!/bin/sh

message_file="$1"
commit_source="$2"

# Preserve messages generated by merges, squashes, and amended commits.
case "$commit_source" in
  merge|squash|commit)
    exit 0
    ;;
esac

machine_id="$(git config --local --get interwork.machineId)"
agent_id="$(git config --local --get interwork.agentId)"

[ -n "$machine_id" ] || machine_id="${COMPUTERNAME:-${HOSTNAME:-unknown-machine}}"
[ -n "$agent_id" ] || agent_id="${INTERWORK_AGENT_ID:-unknown-agent}"

actor_id="${agent_id}@${machine_id}"

if ! grep -q '^InterWork-Actor:' "$message_file"; then
  printf '\nInterWork-Actor: %s\n' "$actor_id" >> "$message_file"
fi

if ! grep -q '^InterWork-Machine:' "$message_file"; then
  printf 'InterWork-Machine: %s\n' "$machine_id" >> "$message_file"
fi

